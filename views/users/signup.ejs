<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Sign Up on WanderLust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="post" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                    <input name="username" id="username" placeholder="Enter Name" class="form-control" required type="text"><br>
                <div class="valid-feedback">Looks Good</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                    <input name="email" id="email" placeholder="Enter Email" class="form-control" required type="email"><br>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                    <input name="password" id="password" placeholder="Enter Password" class="form-control" required type="password"><br>
            </div>
            <button class="btn btn-success">Sign Up</button>
        </form>
    </div>
</div>