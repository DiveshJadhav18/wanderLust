<% layout("layouts/boilerplate") -%>

<body>
    
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h2>Create New Listings</h2><br>
    <form action="/listings " method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" placeholder="Enter Name" class="form-control" required type="text"><br><br>
            <div class="valid-feedback">Good Title</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" placeholder="Enter Description" class="form-control" required type="text"></textarea><br><br>
            <div class="invalid-feedback">Enter short Description</div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload Listing's Image</label>
            <input name="listing[image]" class="form-control" type="file" required><br><br>
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" placeholder="Enter Price" type="number" class="form-control" required><br><br>
                <div class="invalid-feedback">Enter valid Price</div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" placeholder="Enter Country Name" class="form-control" required type="text"><br><br>
                <div class="invalid-feedback">Enter proper Country</div>
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="Enter Location Name" class="form-control" required type="text"><br><br>
            <div class="invalid-feedback">Enter proper Location</div>
        </div>
        <button class="btn add-btn btn-dark mt-3">Add</button><br><br>
    </form>
        </div>
    </div>
</body>